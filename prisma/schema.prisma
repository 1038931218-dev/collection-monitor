// Prisma Schema — AI收款管家 V0.1
//
// 生产环境：PostgreSQL（Neon.tech）
// 开发/测试环境：SQLite（本地文件）
//
// 切换方式：设置 DATABASE_URL 环境变量
//   - 测试：DATABASE_URL="file:./dev.db" → SQLite
//   - 生产：DATABASE_URL="postgresql://..." → PostgreSQL

generator client {
  provider = "prisma-client-js"
}

// ─── 环境自适应数据源 ─────────────────────────────────────────
// 测试环境使用 SQLite，生产环境使用 PostgreSQL
datasource db {
  provider = env("PRISMA_PROVIDER")
  url      = env("DATABASE_URL")
}

// ─── 用户与租户 ───────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password_hash String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  companies    Company[]
  subscriptions Subscription[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  currency    String   @default("USD")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner_id    String
  owner       User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  customers       Customer[]
  invoices        Invoice[]
  paymentRecords  PaymentRecord[]
  uploads         Upload[]
  collectionTasks CollectionTask[]
  aiFeedbacks     AIFeedback[]
  subscriptions   Subscription[]
}

// ─── 客户与发票 ───────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  company_id    String
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name          String
  slug          String   // 标准化小写名称，用于匹配
  contact_email String?
  contact_phone String?
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  invoices       Invoice[]
  paymentRecords PaymentRecord[]

  @@unique([company_id, slug])
  @@index([company_id])
}

model Invoice {
  id                 String   @id @default(cuid())
  company_id         String
  company            Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id        String
  customer           Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_number     String?
  invoice_date       DateTime
  due_date           DateTime
  amount_cents       Int      // 发票总金额（分）
  paid_amount_cents  Int      @default(0) // 累计已付金额（分）
  currency           String   @default("USD")
  status             String   @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID | OVERDUE
  paid_date          DateTime? // 最后一笔付款日期（可由 payment_records 推导）
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  paymentRecords PaymentRecord[]

  @@index([company_id, customer_id])
  @@index([company_id, invoice_number, customer_id])
  @@index([company_id, due_date])
}

model PaymentRecord {
  id             String   @id @default(cuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id    String
  customer       Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_id     String?
  invoice        Invoice? @relation(fields: [invoice_id], references: [id])
  payment_date   DateTime // 实际付款日期
  amount_cents   Int      // 本次付款金额（分）
  currency       String   @default("USD")
  payment_method String?  // bank_transfer | cash | check | credit_card | other
  notes          String?
  created_at     DateTime @default(now())

  @@index([company_id, customer_id, payment_date])
  @@index([company_id, invoice_id, payment_date])
}

// ─── 文件上传与任务 ────────────────────────────────────────

model Upload {
  id           String   @id @default(cuid())
  company_id   String
  company      Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  filename     String
  content_type String?
  file_size    Int      @default(0)
  status       String   @default("PENDING") // PENDING | PARSED | FAILED
  errors       String?
  created_at   DateTime @default(now())

  @@index([company_id, created_at])
}

model CollectionTask {
  id              String   @id @default(cuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoice_id      String?
  customer_id     String?
  priority_score  Int
  priority_level  String   // LOW | MEDIUM | HIGH
  reason          String?
  action          String?
  completed_at    DateTime?
  created_at      DateTime @default(now())

  @@index([company_id, priority_score])
}

// ─── AI 与订阅 ─────────────────────────────────────────────

model AIFeedback {
  id          String   @id @default(cuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  task_id     String?
  rating      Int?     // 1-5
  comment     String?
  created_at  DateTime @default(now())

  @@index([company_id, task_id])
}

model Subscription {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan        String   @default("FREE") // FREE | PRO | ENTERPRISE
  status      String   @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED
  current_period_end DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
  @@index([company_id])
}
