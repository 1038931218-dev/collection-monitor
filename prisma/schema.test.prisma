// Prisma Schema — AI收款管家 V0.1 (SQLite 测试版)
//
// 这是 PostgreSQL schema 的 SQLite 适配版
// 运行测试前执行: npx prisma generate --schema=prisma/schema.test.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── 用户与租户 ───────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password_hash String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  companies    Company[]
  subscriptions Subscription[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  currency    String   @default("USD")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  owner_id    String
  owner       User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  customers       Customer[]
  invoices        Invoice[]
  paymentRecords  PaymentRecord[]
  uploads         Upload[]
  collectionTasks CollectionTask[]
  aiFeedbacks     AIFeedback[]
  subscriptions   Subscription[]
}

// ─── 客户与发票 ───────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  company_id    String
  company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name          String
  slug          String
  contact_email String?
  contact_phone String?
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  invoices       Invoice[]
  paymentRecords PaymentRecord[]

  @@unique([company_id, slug])
  @@index([company_id])
}

model Invoice {
  id                 String   @id @default(cuid())
  company_id         String
  company            Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id        String
  customer           Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_number     String?
  invoice_date       DateTime
  due_date           DateTime
  amount_cents       Int
  paid_amount_cents  Int      @default(0)
  currency           String   @default("USD")
  status             String   @default("UNPAID")
  paid_date          DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  paymentRecords PaymentRecord[]

  @@index([company_id, customer_id])
  @@index([company_id, invoice_number, customer_id])
  @@index([company_id, due_date])
}

model PaymentRecord {
  id             String   @id @default(cuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customer_id    String
  customer       Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  invoice_id     String?
  invoice        Invoice? @relation(fields: [invoice_id], references: [id])
  payment_date   DateTime
  amount_cents   Int
  currency       String   @default("USD")
  payment_method String?
  notes          String?
  created_at     DateTime @default(now())

  @@index([company_id, customer_id, payment_date])
  @@index([company_id, invoice_id, payment_date])
}

// ─── 文件上传与任务 ────────────────────────────────────────

model Upload {
  id           String   @id @default(cuid())
  company_id   String
  company      Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  filename     String
  content_type String?
  file_size    Int      @default(0)
  status       String   @default("PENDING")
  errors       String?
  created_at   DateTime @default(now())

  @@index([company_id, created_at])
}

model CollectionTask {
  id              String   @id @default(cuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoice_id      String?
  customer_id     String?
  priority_score  Int
  priority_level  String
  reason          String?
  action          String?
  completed_at    DateTime?
  created_at      DateTime @default(now())

  @@index([company_id, priority_score])
}

// ─── AI 与订阅 ─────────────────────────────────────────────

model AIFeedback {
  id          String   @id @default(cuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  task_id     String?
  rating      Int?
  comment     String?
  created_at  DateTime @default(now())

  @@index([company_id, task_id])
}

model Subscription {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan        String   @default("FREE")
  status      String   @default("ACTIVE")
  current_period_end DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
  @@index([company_id])
}
