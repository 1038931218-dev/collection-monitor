# 环境变量模板（生产环境使用）
# 复制此文件为 .env，填入真实值

# ─── 数据库（必须）────────────────────────────────────
# PostgreSQL 连接字符串
# 示例：postgresql://user:password@localhost:5432/collection_monitor
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# ─── AI 服务（必须，否则使用 Mock fallback）─────────
# OpenRouter API Key
# 获取地址：https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxx"

# AI Provider 选择：openrouter | mock
# 生产环境设为 openrouter
AI_PROVIDER=openrouter

# ─── 可选配置 ───────────────────────────────────────
# 应用显示名称
NEXT_PUBLIC_APP_NAME="AI收款管家"

# 节点环境（生产环境必须为 production）
NODE_ENV=production
